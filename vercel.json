{
  "rewrites": [
    {
      "source": "/api/football/:path*",
      "destination": "https://api.football-data.org/v4/:path*"
    },
    {
      "source": "/api/pmu/:path*",
      "destination": "https://online.turfinfo.api.pmu.fr/rest/client/61/programme/:path*"
    },
    {
      "source": "/api/nba/:path*",
      "destination": "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/:path*"
    }
  ]
}
